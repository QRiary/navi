// ════════════════════════════════════════════════════════════════════
//  NAVI · user.config
//  App settings. Change values and press “Apply” (Ctrl+S).
//  Format: JSON with comments. Strings go in "quotes", numbers and
//  true/false — without quotes. A deleted line = the default value.
// ════════════════════════════════════════════════════════════════════
{
  // Interface language: "en" | "ru"
  "language": "en",

  "brand": {
    // Name: the logo is built from it (for ASCII — Latin letters and digits)
    "name": "NAVI",
    // Caption under the logo
    "tagline": "keys / layers / firmware",
    // Logo style: "ascii" | "pixel" | "text"
    "logo": "ascii",
    // ASCII fonts: "ANSI Shadow" | "ANSI Regular" | "Calvin S"
    "asciiFont": "ANSI Shadow",     // large logo
    "asciiFontSmall": "Calvin S"    // small (sidebar)
  },

  // Palette: "mono" | "phosphor" | "amber" | "alert" | "paper", or the id of your own theme
  // (Settings → palette → save as new theme; the files are in the themes folder next to this one)
  "theme": "mono",

  // Own colors on top of the palette (#rrggbb). null — the palette color.
  "colors": {
    "background": null,  // window background
    "panel": null,       // panel background
    "cell": null,        // input fields, buttons and other controls
    "card": null,        // boxes in panels: tables, lists, logs (null — follows "cell")
    "hover": null,       // hover highlight
    "border": null,      // borders
    "key": null,         // keys in keyboard drawings (null — follows "cell")
    "keyBorder": null,   // key outlines (null — follows "border")
    "text": null,        // main text
    "textDim": null,     // secondary text
    "label": null,       // UPPERCASE labels
    "accent": null,      // active elements, the selected key
    "accentText": null,  // text on the accent
    "meterFrom": null,   // meters and layer links: gradient start
    "meterTo": null,     // meters: gradient end
    "danger": null       // errors
  },

  "layout": {
    // "compact" | "comfortable" | "spacious"
    "density": "comfortable",
    "sidebar": true,          // sidebar with sections
    "inspector": true,        // right panel: properties of the selected key
    "systemLabels": true,     // service labels like // keymap://default
    "statusLine": true,       // status line: keyboard, layers, changes
    // Panel widths, px. Easier to change with the mouse: drag the panel edge
    // (double-click the edge to reset).
    "sidebarWidth": 232,      // left panel (64…420)
    "inspectorWidth": 340,    // right panel (280…600)
    // Interface size: zoom of the whole window, 0.8…2 (1 = 100%). Also Settings → main,
    // Ctrl+= / Ctrl+- / Ctrl+0 and Ctrl+wheel.
    "zoom": 1
  },

  "shape": {
    "panelRadius": 0,  // panel corner radius, px (0…32)
    "keyRadius": 2     // key corner radius on the drawing, px (0…30)
  },

  "typography": {
    "font": "mono", // "mono" | "sans"
    "scale": 1      // text only, on top of the interface size (layout.zoom), 0.8…1.3
  },

  "surfaces": {
    "opacity": 1, // panel opacity, 0.3…1
    "blur": 0     // blur under panels, px (visible when opacity < 1)
  },

  "effects": {
    "scanlines": 0.3,  // scan lines, 0…1
    "noise": 0.12,     // signal noise, 0…1
    "vignette": 0.6,   // light at the top of the screen, 0…1
    "glow": 0,         // glow of active elements, 0…1
    "glitch": false,   // signal glitch on headers on hover
    "wires": false,    // wires in the background
    "animations": true
  },

  "keyboard": {
    // GUI key label: "windows" → Win, "macos" → Cmd, "linux" → Super
    "os": "windows",
    // Second label on keys — the computer's layout: "none" | "russian" | "german" | …
    "hostLayout": "none",
    "showMatrix": false,             // show the matrix [row,col] on keys
    "showTransparentSource": true,   // on transparent keys — what “shows through” from below
    "keySize": 54                    // key size on the drawing at 100%, px (32…96)
  },

  "editor": {
    "snap": 0.25,                // snap step in the geometry editor, u (0 — no snapping)
    "confirmDeviceWrite": true   // ask before writing to the keyboard
  },

  "device": {
    "autoConnect": true,  // connect to a known keyboard on start
    "liveWrite": false    // write every change to the keyboard right away (like VIA)
  },

  "qmk": {
    // qmk_firmware folder. Empty — ask the QMK CLI (qmk config user.qmk_home)
    "home": "",
    // QMK MSYS folder (Windows). Empty — look in C:\QMK_MSYS
    "msys": "",
    // WSL distro with QMK (Windows). Empty — the distro where qmk is found
    "wsl": ""
  },

  // Any CSS variables directly
  "vars": {
    // "--panel-border-width": "1px"
  }
}
